{
  "name": "kite",
  "private": true,
  "version": "0.1.0",
  "description": "Kite — social-first, gasless, multichain crypto trading",
  "license": "MIT",
    "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kite/api start:dev",
    "dev:mobile": "pnpm --filter @kite/mobile start",
    "build": "pnpm -r --filter @kite/shared-types --filter @kite/ui --filter @kite/api build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @kite/api prisma:migrate",
    "db:seed": "pnpm --filter @kite/api prisma:seed",
    "db:reset": "pnpm --filter @kite/api prisma:reset"
  }
}
